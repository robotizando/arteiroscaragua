# Este arquivo documenta as variáveis usadas pelo monorepo.
# Copie os trechos relevantes para apps/backend/.env, apps/admin/.env.local e apps/frontend/.env.local

# ---- apps/backend/.env ----
PORT=4001
DATABASE_URL=./data/dev.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=http://localhost:4001
ADMIN_URL=http://localhost:4002
SITE_URL=http://localhost:4003
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=10m
USER_JWT_SECRET=troque-por-outro-segredo-forte
USER_JWT_EXPIRES_IN=7d
# SMTP para os e-mails de verificação e recuperação de senha.
# Sem SMTP_HOST, os e-mails (com os links) são exibidos no console do backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Arteiros Caragua <nao-responda@arteiroscaragua.com.br>
NODE_ENV=development

# ---- apps/admin/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4001

# ---- apps/frontend/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4001
