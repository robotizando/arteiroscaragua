{
  "name": "arteiroscaragua",
  "version": "1.0.0",
  "description": "Site arteiroscaragua.com.br - v2",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter backend run db:migrate",
    "db:seed": "pnpm --filter backend run db:seed",
    "db:setup": "pnpm run db:migrate && pnpm run db:seed",
    "preinstall": "node -e \"if(parseInt(process.version.slice(1))<20){console.error('\\n❌ Node 20+ é necessário! Atual: '+process.version+'\\nRode: nvm use 20\\n');process.exit(1)}\""
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
