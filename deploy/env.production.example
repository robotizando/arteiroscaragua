# Modelo de /var/www/arteiroscaragua/shared/.env (chmod 600).
# Os valores __*__ são gerados por bootstrap-server.sh. Nunca versione o arquivo real.

NODE_ENV=production
DATABASE_URL=/var/www/arteiroscaragua/shared/data/production.sqlite

# Sem barra no final. BACKEND_URL não inclui /api.
BACKEND_URL=https://arteiroscaragua.com.br
ADMIN_URL=https://admin.arteiroscaragua.com.br
SITE_URL=https://arteiroscaragua.com.br

JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES_IN=10m
USER_JWT_SECRET=__USER_JWT_SECRET__
USER_JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# Redirects autorizados no Google:
#   https://arteiroscaragua.com.br/api/auth/google/callback
#   https://arteiroscaragua.com.br/api/conta/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obrigatório antes de abrir o cadastro: sem SMTP_HOST, links com token vão para os logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Arteiros Caragua <nao-responda@arteiroscaragua.com.br>"

# Admin criado pelo seed (opcional).
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_NOME=
